# Database connection
DATABASE_URL=postgresql://postgres:localpassword@localhost:5432/evidence_platform

# Redis cache and rate limiting connection
REDIS_URL=redis://localhost:6379/0

# Qdrant connection settings
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=

# NCBI API Settings
NCBI_API_KEY=
NCBI_EMAIL=

# ML / AI Provider Settings (options: mock | hosted)
LLM_PROVIDER=mock
LLM_API_KEY=
EMBEDDING_PROVIDER=mock
RERANKER_PROVIDER=mock
ENTAILMENT_PROVIDER=mock

# App Security Settings
SESSION_SECRET_KEY=local_development_secret_key_32_chars_long
JWT_SECRET_KEY=local_development_jwt_secret_key
CSRF_SECRET_KEY=local_development_csrf_secret_key
